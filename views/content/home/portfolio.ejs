<div id="portfolio" class="container">
    <div id="projects" class="col justify-center">
        <div class="padd-y-5">
            <h2 class="uppercase">Select Work</h2>
        </div>
        <div class="row wrap justify-center gap-10">
            <!-- Acopon -->
            <div class="card featured gap-4">
                <div id="acopon" class="img-container justify-end relative">
                </div>
                <div class="tag-container">
                    <ul class="row relative gap-4">
                        <li class="chip">Branding</li>
                        <li class="chip">Illustration</li>
                        <li class="chip" data-hide="500">Print Design</li>
                    </ul>
                </div>
                <div class="content justify-between" data-stack="500">
                    <div class="col justify-center flex-basis-80">
                        <h3>Differentiating a Brewery with Traditional Styles.</h3>
                    </div>
                    <div class="col justify-end flex-basis-33">
                        <div class="row justify-end" data-start="500">
                            <a class="btn primary" href="/acoponbrewing" rel="noopener noreferrer">View Work</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Labels -->
            <div class="card gap-4">
                <div id="labels" class="img-container justify-end relative">
                </div>
                <div class="tag-container">
                    <ul class="row relative gap-4">
                        <li class="chip">Illustration</li>
                        <li class="chip">Print</li>
                    </ul>
                </div>
                <div class="can-block">
                    <div class="relative">
                        <img class="craft-can width-100" src="/assets/images/projects/labels/cans/cactus-palace-can.webp"
                            alt="Beer can with an illustrative label" width="276" height="698" loading="lazy"
                            decoding="async">
                        <img class="craft-can width-100" src="/assets/images/projects/labels/cans/empress-rising-can.webp"
                            alt="Beer can with an illustrative label" width="276" height="698" loading="lazy"
                            decoding="async">
                        <img class="craft-can width-100" src="/assets/images/projects/labels/cans/powerfades-can.webp"
                            alt="Beer can with an illustrative label" width="276" height="696" loading="lazy"
                            decoding="async">
                        <img class="craft-can width-100" src="/assets/images/projects/labels/cans/hanstrapp-can.webp"
                            alt="Beer can with an illustrative label" width="276" height="698" loading="lazy"
                            decoding="async">
                        <img class="craft-can width-100" src="/assets/images/projects/labels/cans/paria-can.webp"
                            alt="Beer can with an illustrative label" width="276" height="698" loading="lazy"
                            decoding="async">
                    </div>
                </div>
                <div class="content justify-between" data-stack="500">
                    <div class="col justify-center flex-basis-60">
                        <h3>Craft Beer Labels</h3>
                    </div>
                    <div class="col justify-end flex-basis-33">
                        <div class="row justify-end" data-start="500">
                            <a class="btn primary" href="/labels" rel="noopener noreferrer">View Work</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Logos -->
            <div class="card gap-4">
                <div id="logos" class="img-container relative">
                    <img class="logos-home-card" src="/assets/images/projects/featured/logo-card-img-1.png"
                        srcset="<%= imgSrcset('/assets/images/projects/featured/logo-card-img-1.png') %>"
                        sizes="(max-width: 990px) 80vw, 420px"
                        alt="Logo design sample" width="1240" height="972" loading="lazy" decoding="async" />
                    <img class="logos-home-card" src="/assets/images/projects/featured/logo-card-img-2.png"
                        srcset="<%= imgSrcset('/assets/images/projects/featured/logo-card-img-2.png') %>"
                        sizes="(max-width: 990px) 80vw, 420px"
                        alt="Logo design sample" width="1240" height="1178" loading="lazy" decoding="async" />
                    <img class="logos-home-card" src="/assets/images/projects/featured/logo-card-img-3.png"
                        srcset="<%= imgSrcset('/assets/images/projects/featured/logo-card-img-3.png') %>"
                        sizes="(max-width: 990px) 80vw, 420px"
                        alt="Logo design sample" width="953" height="1036" loading="lazy" decoding="async" />
                    <img class="logos-home-card" src="/assets/images/projects/featured/logo-card-img-4.png"
                        srcset="<%= imgSrcset('/assets/images/projects/featured/logo-card-img-4.png') %>"
                        sizes="(max-width: 990px) 80vw, 420px"
                        alt="Logo design sample" width="1478" height="646" loading="lazy" decoding="async" />
                </div>
                <div class="tag-container">
                    <ul class="row relative gap-4">
                        <li class="chip">Identity</li>
                        <li class="chip">Iconography</li>
                    </ul>
                </div>
                <div class="content justify-between" data-stack="500">
                    <div class="col justify-center flex-basis-60">
                        <h3>Logos! Logos! Logos!</h3>
                    </div>
                    <div class="col justify-end flex-basis-33">
                        <div class="row justify-end" data-start="500">
                            <a class="btn primary" href="/logos" rel="noopener noreferrer">View Work</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- DentalRay -->
            <div class="card featured gap-4">
                <div id="dentalray" class="img-container justify-end relative">
                    <div class="vid-bg">
                        <video muted="" loop="" id="intro-vid" playsinline webkit-playsinline preload="none"
                            data-lazy-video>
                            <source
                                data-src="https://embed-ssl.wistia.com/deliveries/ec2de1463e5ba017b15b7d71c70f2bd5b3930f64.bin?disposition=attachment&amp;filename=hero-bg.mp4"
                                type="video/mp4">
                        </video>
                    </div>
                </div>
                <div class="tag-container">
                    <ul class="row relative gap-4">
                        <li><span class="chip" data-hide="500">Case Studies</span></li>
                        <li><span class="chip">Product Design</span></li>
                        <li><span class="chip">Design Systems</span></li>
                        <li><span class="chip" data-hide="500">Front-End</span></li>
                    </ul>
                </div>
                <div class="content justify-between" data-stack="500">
                    <div class="col justify-center flex-basis-75">
                        <h3>Rebuilding an Industry-First Radiology Company for Growth.</h3>
                    </div>
                    <div class="col justify-end flex-basis-25">
                        <div id="coming-soon" class="row justify-end">
                            <a class="btn primary text-center" href="/#" rel="noopener noreferrer" disabled>Coming
                                Soon</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>