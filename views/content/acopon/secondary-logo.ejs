<div id="secondary-mark" class="container width-100 gap-12">
    <h2>Secondary Mark</h2>
    <div class="row gap-7" data-stack="768">
        <div class="col flex-basis-40 justify-between align-item-center gap-8 padd-10">
            <img class="secondary-mark"
                src="/assets/images/projects/acopon/secondary-mark/acopon-secondary-mark-full.webp" srcset="<%= imgSrcset('/assets/images/projects/acopon/secondary-mark/acopon-secondary-mark-full.webp') %>" sizes="(max-width: 768px) 90vw, 50vw" loading="lazy" decoding="async"
                alt="Secondary logo for Acpopon Brewing Co. depicts a plague doctor facing left with the name underneath."
                data-img-theme="default">
            <img class="secondary-mark"
                src="/assets/images/projects/acopon/secondary-mark/acopon-secondary-mark-1color.webp" srcset="<%= imgSrcset('/assets/images/projects/acopon/secondary-mark/acopon-secondary-mark-1color.webp') %>" sizes="(max-width: 768px) 90vw, 50vw" loading="lazy" decoding="async"
                alt="Secondary logo for Acpopon Brewing Co. depicts a plague doctor facing left with the name underneath."
                data-img-theme="default">
            <img class="secondary-mark"
                src="/assets/images/projects/acopon/secondary-mark/acopon-secondary-mark-full-inverse.webp" srcset="<%= imgSrcset('/assets/images/projects/acopon/secondary-mark/acopon-secondary-mark-full-inverse.webp') %>" sizes="(max-width: 768px) 90vw, 50vw" loading="lazy" decoding="async"
                alt="Secondary logo for Acpopon Brewing Co. depicts a plague doctor facing left with the name underneath."
                data-img-theme="inverse">
            <img class="secondary-mark"
                src="/assets/images/projects/acopon/secondary-mark/acopon-secondary-mark-1color-inverse.webp" srcset="<%= imgSrcset('/assets/images/projects/acopon/secondary-mark/acopon-secondary-mark-1color-inverse.webp') %>" sizes="(max-width: 768px) 90vw, 50vw" loading="lazy" decoding="async"
                alt="Secondary logo for Acpopon Brewing Co. depicts a plague doctor facing left with the name underneath."
                data-img-theme="inverse">
        </div>
        <div class="row flex-basis-60 img-panel overflow-hidden justify-end align-item-center">
            <img class="width-134" src="/assets/images/projects/acopon/acopon-secondary-glass.webp" srcset="<%= imgSrcset('/assets/images/projects/acopon/acopon-secondary-glass.webp') %>" sizes="(max-width: 768px) 90vw, 50vw" loading="lazy" decoding="async"
                alt="Secondary logo for Acpopon Brewing Co. depicts a plague doctor facing left with the name underneath.">
        </div>
    </div>
</div>